{
  "name": "e-list",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "data:build": "node scripts/build-catalog.mjs",
    "data:extract": "node scripts/extract-chat-seed.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "npm run lint:eslint && npm run lint:stylelint && npm run lint:prettier && npm run lint:fsd",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "lint:prettier": "prettier --check .",
    "lint:fsd": "steiger src",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,scss}\" --fix && prettier --write .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.24.1",
    "@playwright/test": "^1.60.0",
    "@st1ggy/linter-config": "^7.2.2",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "cheerio": "^1.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.6.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "melt": "^0.44.0"
  }
}
