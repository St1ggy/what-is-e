{
  "name": "e-list",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "data:build": "bun scripts/build-catalog.mjs",
    "preview": "bun --bun vite preview",
    "prepare": "bun --bun svelte-kit sync || echo ''",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "bun run lint:eslint && bun run lint:stylelint && bun run lint:prettier",
    "lint:eslint": "bun --bun eslint .",
    "lint:stylelint": "bun --bun stylelint \"src/**/*.{css,scss}\"",
    "lint:prettier": "bun --bun prettier --check .",
    "lint:fix": "bun --bun eslint . --fix && bun --bun stylelint \"src/**/*.{css,scss}\" --fix && bun --bun prettier --write .",
    "format": "bun --bun prettier --write .",
    "test:unit": "bun --bun vitest",
    "test": "bun run test:unit --run && bun run test:e2e",
    "test:e2e": "bun --bun playwright install && bun --bun playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.24.1",
    "@playwright/test": "^1.60.0",
    "@st1ggy/linter-config": "^7.2.2",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24",
    "cheerio": "^1.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.6.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "melt": "^0.44.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "encoding-sniffer": "^1.0.2",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1"
  }
}
